# Copy this file to .env and fill in. Nothing is ever sent to a bank.
# Gmail: turn on 2-step verification, then Google Account > Security > App passwords > create one for "Mail".
VASOOL_SMTP_USER=yourname@gmail.com
VASOOL_SMTP_PASS=xxxx xxxx xxxx xxxx
# SAFETY NET: when set, every mail goes to this address no matter who the recipient is.
VASOOL_DEMO_TO=teammate@gmail.com
# Optional: so the Approve button in the mail opens the app from a phone on the same hotspot.
# Use the IPv4 address run.bat prints, e.g. http://192.168.43.12:8000
VASOOL_PUBLIC_URL=
# Optional: the assistant may rephrase answers with an LLM (facts still come from the rulebook)
# VASOOL_LLM=on
# ANTHROPIC_API_KEY=
